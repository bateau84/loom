{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "general": {
      "model": "surplus/gpt-5.6-luna",
      "reasoningEffort": "none",
      "textVerbosity": "low"
    },
    "brainstorm": {
      "model": "surplus/gpt-5.6-terra",
      "reasoningEffort": "low",
      "textVerbosity": "medium"
    },
    "designer": {
      "model": "surplus/gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "textVerbosity": "medium"
    },
    "specifier": {
      "model": "surplus/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "architect": {
      "model": "surplus/gpt-5.6-sol",
      "reasoningEffort": "max",
      "textVerbosity": "medium"
    },
    "reviewer": {
      "model": "surplus/gpt-5.6-luna",
      "reasoningEffort": "max",
      "textVerbosity": "low"
    },
    "critic": {
      "model": "surplus/gpt-5.6-sol",
      "reasoningEffort": "max",
      "textVerbosity": "medium"
    },
    "acceptance": {
      "model": "surplus/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "planner": {
      "model": "surplus/gpt-5.6-sol",
      "reasoningEffort": "max",
      "textVerbosity": "medium"
    },
    "worker": {
      "model": "surplus/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    },
    "research": {
      "model": "surplus/gpt-5.6-sol",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "diagnostic": {
      "model": "surplus/gpt-5.6-terra",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "documenter": {
      "model": "surplus/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    }
  },
  "providers": {
    "surplus": {
      "package": "@ai-sdk/openai-compatible",
      "name": "Surplus Intelligence",
      "options": {
        "baseURL": "https://api.surplusintelligence.ai/v1"
      },
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-5.6-sol-pro": {
          "name": "GPT-5.6 Sol Pro",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "claude-fable-5": {
          "name": "Claude Fable 5"
        }
      }
    }
  }
}
