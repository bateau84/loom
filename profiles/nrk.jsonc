{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "general": {
      "model": "litellm/claude-sonnet-4-6"
    },
    "brainstorm": {
      "model": "litellm/claude-sonnet-4-6"
    },
    "designer": {
      "model": "litellm/claude-opus-4-6",
      "reasoningEffort": "medium"
    },
    "specifier": {
      "model": "litellm/claude-sonnet-4-6",
      "reasoningEffort": "high"
    },
    "architect": {
      "model": "litellm/claude-opus-4-6",
      "reasoningEffort": "high"
    },
    "reviewer": {
      "model": "litellm/claude-sonnet-4-6"
    },
    "critic": {
      "model": "litellm/claude-opus-4-6"
    },
    "acceptance": {
      "model": "litellm/claude-opus-4-6"
    },
    "planner": {
      "model": "litellm/claude-sonnet-4-6"
    },
    "worker": {
      "model": "litellm/claude-sonnet-4-6"
    },
    "research": {
      "model": "litellm/claude-sonnet-4-6"
    },
    "diagnostic": {
      "model": "litellm/claude-opus-4-6"
    },
    "documenter": {
      "model": "litellm/claude-sonnet-4-6"
    }
  },
  "providers": {
    "litellm": {
      "package": "@ai-sdk/anthropic",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.plattform-int.k8s.ma.nrk.cloud/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "claude-opus-4-6"
        },
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6"
        },
        "gpt-5.5": {
          "name": "gpt-5.5"
        }
      }
    }
  }
}
