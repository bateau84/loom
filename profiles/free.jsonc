{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "general": {
      "model": "opencode/mimo-v2.5-free",
      "temperature": 0.1
    },
    "brainstorm": {
      "model": "opencode/big-pickle",
      "temperature": 0.8
    },
    "designer": {
      "model": "opencode/mimo-v2.5-free",
      "temperature": 0.5
    },
    "specifier": {
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0.1,
      "reasoningEffort": "high"
    },
    "architect": {
      "model": "opencode/mimo-v2.5-free",
      "temperature": 0.2,
      "reasoningEffort": "high"
    },
    "reviewer": {
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0.1
    },
    "critic": {
      "model": "opencode/mimo-v2.5-free",
      "temperature": 0.5
    },
    "acceptance": {
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0.1
    },
    "planner": {
      "model": "opencode/mimo-v2.5-free",
      "temperature": 0.0
    },
    "worker": {
      "model": "opencode/muse-spark-1.2-contributor-free",
      "temperature": 0.0
    },
    "research": {
      "model": "opencode/mimo-v2.5-free",
      "temperature": 0.2
    },
    "diagnostic": {
      "model": "opencode/mimo-v2.5-free",
      "temperature": 0.0
    },
    "documenter": {
      "model": "opencode/mimo-v2.5-free",
      "temperature": 0.1
    }
  }
}
