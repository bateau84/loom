{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "general": {
      "model": "modellbanken/gpt-5.6-terra"
    },
    "brainstorm": {
      "model": "modellbanken/gpt-5.6-terra"
    },
    "designer": {
      "model": "modellbanken/claude-sonnet-5",
      "reasoningEffort": "medium"
    },
    "specifier": {
      "model": "modellbanken/gpt-5.6-sol",
      "reasoningEffort": "high"
    },
    "architect": {
      "model": "modellbanken/gpt-5.6-sol",
      "reasoningEffort": "high"
    },
    "reviewer": {
      "model": "modellbanken/gpt-5.6-sol"
    },
    "critic": {
      "model": "modellbanken/gpt-5.6-sol",
      "reasoningEffort": "high"
    },
    "acceptance": {
      "model": "modellbanken/gpt-5.6-sol",
      "reasoningEffort": "high"
    },
    "planner": {
      "model": "modellbanken/gpt-5.6-terra"
    },
    "worker": {
      "model": "modellbanken/DeepSeek-V4-Flash"
    },
    "research": {
      "model": "modellbanken/gpt-5.6-terra"
    },
    "diagnostic": {
      "model": "modellbanken/claude-sonnet-5"
    },
    "documenter": {
      "model": "modellbanken/gpt-5.6-terra"
    }
  },
  "providers": {
    "modellbanken": {
      "package": "@ai-sdk/anthropic",
      "name": "Modellbanken",
      "options": {
        "setCacheKey": true,
        "baseURL": "https://modellbanken.kihub.nrk.cloud/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "claude-opus-4-6"
        },
        "claude-opus-5": {
          "name": "claude-opus-5"
        },
        "claude-sonnet-5": {
          "name": "claude-sonnet-5"
        },
        "claude-haiku-4-5": {
          "name": "claude-haiku-4-5"
        },
        "DeepSeek-V4-Flash": {
          "name": "DeepSeek-V4-Flash"
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "name": "gpt-5.6-terra",
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "name": "gpt-5.6-luna",
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        }
      }
    }
  }
}
