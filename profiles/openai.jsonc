{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "general": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "brainstorm": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "high"
    },
    "designer": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "medium"
    },
    "specifier": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "high"
    },
    "architect": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "high"
    },
    "reviewer": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "critic": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "high"
    },
    "acceptance": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "planner": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "worker": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    },
    "research": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "diagnostic": {
      "model": "openai/gpt-5.6-sol",
      "reasoningEffort": "high",
      "textVerbosity": "medium"
    },
    "documenter": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-5.6-luna-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-5.6-sol-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        },
        "gpt-5.6-terra-fast": {
          "limit": {
            "context": 1000000,
            "input": 872000,
            "output": 128000
          }
        }
      }
    }
  }
}
