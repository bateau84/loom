{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#160F1E",
    "panel": "#21142C",
    "element": "#30203C",
    "text": "#F5EAFE",
    "muted": "#A38BB5",
    "primary": "#D946EF",
    "secondary": "#A855F7",
    "accent": "#22D3EE",
    "success": "#34D399",
    "warning": "#FBBF24",
    "error": "#FB7185",
    "info": "#60A5FA",
    "lightBg": "#FFF8FF",
    "lightPanel": "#F8EBFB",
    "lightElement": "#EFDDF5",
    "lightText": "#35153E",
    "lightMuted": "#80628B",
    "lightPrimary": "#A21CAF",
    "lightSecondary": "#7E22CE",
    "lightAccent": "#0891B2"
  },
  "theme": {
    "primary": {
      "dark": "primary",
      "light": "lightPrimary"
    },
    "secondary": {
      "dark": "secondary",
      "light": "lightSecondary"
    },
    "accent": {
      "dark": "accent",
      "light": "lightAccent"
    },
    "error": {
      "dark": "error",
      "light": "error"
    },
    "warning": {
      "dark": "warning",
      "light": "warning"
    },
    "success": {
      "dark": "success",
      "light": "success"
    },
    "info": {
      "dark": "info",
      "light": "info"
    },
    "text": {
      "dark": "text",
      "light": "lightText"
    },
    "textMuted": {
      "dark": "muted",
      "light": "lightMuted"
    },
    "background": {
      "dark": "bg",
      "light": "lightBg"
    },
    "backgroundPanel": {
      "dark": "panel",
      "light": "lightPanel"
    },
    "backgroundElement": {
      "dark": "element",
      "light": "lightElement"
    },
    "border": {
      "dark": "element",
      "light": "lightElement"
    },
    "borderActive": {
      "dark": "primary",
      "light": "lightPrimary"
    },
    "borderSubtle": {
      "dark": "panel",
      "light": "lightPanel"
    },
    "diffAdded": {
      "dark": "success",
      "light": "success"
    },
    "diffRemoved": {
      "dark": "error",
      "light": "error"
    },
    "diffContext": {
      "dark": "muted",
      "light": "lightMuted"
    },
    "diffHunkHeader": {
      "dark": "info",
      "light": "info"
    },
    "diffHighlightAdded": {
      "dark": "success",
      "light": "success"
    },
    "diffHighlightRemoved": {
      "dark": "error",
      "light": "error"
    },
    "diffAddedBg": {
      "dark": "panel",
      "light": "lightPanel"
    },
    "diffRemovedBg": {
      "dark": "panel",
      "light": "lightPanel"
    },
    "diffContextBg": {
      "dark": "bg",
      "light": "lightBg"
    },
    "diffLineNumber": {
      "dark": "muted",
      "light": "lightMuted"
    },
    "diffAddedLineNumberBg": {
      "dark": "element",
      "light": "lightElement"
    },
    "diffRemovedLineNumberBg": {
      "dark": "element",
      "light": "lightElement"
    },
    "markdownText": {
      "dark": "text",
      "light": "lightText"
    },
    "markdownHeading": {
      "dark": "primary",
      "light": "lightPrimary"
    },
    "markdownLink": {
      "dark": "secondary",
      "light": "lightSecondary"
    },
    "markdownLinkText": {
      "dark": "accent",
      "light": "lightAccent"
    },
    "markdownCode": {
      "dark": "success",
      "light": "success"
    },
    "markdownBlockQuote": {
      "dark": "muted",
      "light": "lightMuted"
    },
    "markdownEmph": {
      "dark": "accent",
      "light": "lightAccent"
    },
    "markdownStrong": {
      "dark": "warning",
      "light": "warning"
    },
    "markdownHorizontalRule": {
      "dark": "muted",
      "light": "lightMuted"
    },
    "markdownListItem": {
      "dark": "primary",
      "light": "lightPrimary"
    },
    "markdownListEnumeration": {
      "dark": "secondary",
      "light": "lightSecondary"
    },
    "markdownImage": {
      "dark": "info",
      "light": "info"
    },
    "markdownImageText": {
      "dark": "accent",
      "light": "lightAccent"
    },
    "markdownCodeBlock": {
      "dark": "text",
      "light": "lightText"
    },
    "syntaxComment": {
      "dark": "muted",
      "light": "lightMuted"
    },
    "syntaxKeyword": {
      "dark": "secondary",
      "light": "lightSecondary"
    },
    "syntaxFunction": {
      "dark": "primary",
      "light": "lightPrimary"
    },
    "syntaxVariable": {
      "dark": "accent",
      "light": "lightAccent"
    },
    "syntaxString": {
      "dark": "success",
      "light": "success"
    },
    "syntaxNumber": {
      "dark": "warning",
      "light": "warning"
    },
    "syntaxType": {
      "dark": "info",
      "light": "info"
    },
    "syntaxOperator": {
      "dark": "secondary",
      "light": "lightSecondary"
    },
    "syntaxPunctuation": {
      "dark": "text",
      "light": "lightText"
    }
  }
}
