    "syntaxKeyword": {
      "dark": "#8DCFC0",
      "light": "#13715D"
    },
    "syntaxFunction": {
      "dark": "#B8D7FF",
      "light": "#315F98"
    },
    "syntaxVariable": {
      "dark": "#E5E5E5",
      "light": "#303030"
    },
    "syntaxString": {
      "dark": "#A8D8A8",
      "light": "#477A47"
    },
    "syntaxNumber": {
      "dark": "#C9B8F4",
      "light": "#7256A8"
    },
    "syntaxType": {
      "dark": "#73CFC4",
      "light": "#23786F"
    },
    "syntaxOperator": {
      "dark": "#A8A8A8",
      "light": "#606060"
    },
    "syntaxPunctuation": {
      "dark": "#CFCFCF",
      "light": "#505050"
