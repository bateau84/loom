{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0D0D0D",
    "panel": "#171717",
    "element": "#212121",
    "text": "#ECECEC",
    "textMuted": "#8E8E8E",
    "textSubtle": "#666666",
    "green": "#10A37F",
    "greenBright": "#19C39A",
    "greenMuted": "#0D7F65",
    "red": "#E5484D",
    "orange": "#F59E0B",
    "yellow": "#D8B44C",
    "blue": "#6EA8FE",
    "cyan": "#67D4CF",
    "violet": "#8B5CF6",
    "magenta": "#EC4899",
    "border": "#2A2A2A",
    "borderActive": "#4A4A4A",
    "diffAddedBg": "#102B23",
    "diffRemovedBg": "#30191B",
    "diffContextBg": "#151515",
