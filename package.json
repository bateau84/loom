{
  "name": "loom-plugin",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": { ".": "./server.ts", "./server": "./server.ts" },
  "files": ["server.ts", "src", "README.md", "docs", "examples"],
  "engines": { "bun": ">=1.4.2 <2.0.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:core": "tsc -p tsconfig.core.json && node --test tests/*.test.mjs",
    "test:native": "bun test tests/*native.test.ts tests/package-entry.test.ts tests/manual-backup-restore.test.ts tests/fixtures/baseline-c9ffcfa/*.test.ts tests/question-host/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:installed-questions": "python3 tests/installed_questions.py",
    "test": "bun run test:core && bun run test:native"
  },
  "dependencies": { "@opencode/plugin": "2.2.0", "js-yaml": "4.3.2" },
  "devDependencies": { "@types/bun": "1.4.2", "@types/node": "^22.0.0", "typescript": "7.0.2" }
}
